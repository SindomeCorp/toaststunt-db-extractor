{
  "name": "@sindomecorp/toaststunt-db-extractor",
  "version": "0.1.0",
  "description": "Extract normalized object, verb, property, value, and verb-code data from ToastStunt checkpoint databases.",
  "type": "module",
  "bin": {
    "toaststunt-db-extract": "./dist/src/cli.js",
    "toaststunt-db-inspect": "./dist/src/cli.js",
    "toaststunt-db-validate": "./dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test \"dist/test/**/*.js\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "extract": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0"
  },
  "license": "MIT"
}
