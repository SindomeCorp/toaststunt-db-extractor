{
  "name": "@sindomecorp/toaststunt-db-extractor",
  "version": "0.1.3",
  "description": "Extract normalized object, verb, property, value, and verb-code data from ToastStunt checkpoint databases.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "toaststunt-db-extract": "dist/src/cli.js",
    "toaststunt-db-inspect": "dist/src/cli.js",
    "toaststunt-db-validate": "dist/src/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test \"dist/test/**/*.js\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "extract": "node dist/src/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test && npm run typecheck && npm run lint"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/SindomeCorp/toaststunt-db-extractor.git"
  },
  "bugs": {
    "url": "https://github.com/SindomeCorp/toaststunt-db-extractor/issues"
  },
  "homepage": "https://github.com/SindomeCorp/toaststunt-db-extractor#readme",
  "keywords": [
    "toaststunt",
    "lambdamoo",
    "moo",
    "database",
    "extractor"
  ],
  "author": "SindomeCorp",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0"
  }
}
